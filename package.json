{
  "name": "telegram-support-bot",
  "version": "1.0.0",
  "description": "Telegram bot for customer support with live operators",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "npx prisma migrate deploy && node dist/index.js",
    "postinstall": "npm run build && npx prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "telegram",
    "bot",
    "support",
    "customer-service"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "5.7.1",
    "better-sqlite3": "^12.5.0",
    "dotenv": "^16.3.1",
    "telegraf": "^4.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "prisma": "5.7.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
